<div class="display-container">
    <h2>Edit profile</h2>
    
    <% if (messages && messages.error) { %>
        <div class="error"><%= messages.error[0] %></div>
    <% } %>

    <form id="edit-profile-form" action="/api/user/edit-profile" method="PATCH" data-api data-redirect="/user/profile">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label for="username">Username:</label><br/>
      <input type="text" id="username" name="username" value="<%= user.username %>"/><br/><br/>

      <label for="password">New password:</label><br/>
      <input type="password" name="password"/><br/><br/>

      <button type="submit">Save changes</button>
    </form>

    <div class="links">
        <a href="/">Back to homepage</a>
    </div>
</div>