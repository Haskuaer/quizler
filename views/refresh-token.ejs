<script>
    setInterval(() => {
        fetch('/refresh-token', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'X-CSRF-Token': '<%= csrfToken %>'
            }
        }).then(res => {
            if (!res.ok) console.warn('Refresh token failed: ', res.status);
        }).catch(console.error);
    }, 55000);
</script>