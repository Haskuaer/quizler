<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link rel="stylesheet" href="/styles/styles.css">
    <title>Quizler</title>
</head>
<body>
    
    <header class="header">
        <div class="logo"><a href='/'>Quizler</a></div>
        <div class="nav">
            <% if (user) { %>
                <span class="user">👤 <%= user.username %></span>
                <a href="/">Home</a>
                <a href="#" id="logout">Logout</a>
            <% } else { %>
                <a href="/auth/login" class="js-link">Login</a>
                <a href="/auth/register" class="js-link">Register</a>
            <% } %>
        </div>
    </header>

    <main id="main-content">
    </main>

    <footer class="footer">
        <p>Copyrights</p>
    </footer>

    <script type="module" src="/js/loadView.js"></script>

</body>
</html>