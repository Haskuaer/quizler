<div id="quiz-play">

  <h1 id="quiz-title">Loading quiz...</h1>

  <div id="quiz-container">
    <!-- Cała struktura quizu -->
    <div id="timer"></div>
    <div id="progress"></div>

    <div id="controls">
      <button id="start-btn">▶️ Start</button>
      <button id="stop-btn">⏸️ Stop</button>
      <button id="resume-btn">🔁 Resume</button>
      <button id="giveup-btn">🏳️ Give Up</button>
    </div>

    <img id="flag-img" src="" width="300" />

    <div id="nav-buttons">
      <button id="prev-btn">⬅️</button>
      <button id="next-btn">➡️</button>
    </div>

    <form id="quiz-form">
      <input type="text" id="answer-input" placeholder="Your answer" required />
      <button type="submit">Submit</button>
    </form>

    <div id="like-section">
      <button id="like-btn">❤️ Like</button>
    </div>

    <p id="message"></p>
  </div>
</div>