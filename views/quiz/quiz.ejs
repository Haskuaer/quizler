<main id="quiz-play">
  <meta name="csrf-token" content="<%= csrfToken %>">

  <h1 id="quiz-title">Loading quiz...</h1>

  <div id="quiz-container" style="display: none;">
    <div id="timer"></div>
    <div id="progress"></div>

    <div id="controls">
      <button id="start-btn">▶️ Start</button>
      <button id="stop-btn">⏸️ Stop</button>
      <button id="resume-btn">🔁 Resume</button>
      <button id="giveup-btn">🏳️ Give Up</button>
    </div>

    <img id="flag-img" src="" alt="Flag" width="300" />

    <div id="nav-buttons">
      <button id="prev-btn">⬅️ Prev</button>
      <button id="next-btn">➡️ Next</button>
    </div>

    <form id="quiz-form">
      <input type="text" id="answer-input" placeholder="Country name" required />
      <button type="submit">Submit</button>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>

    <div id="like-section">
      <button id="like-btn">❤️ Like</button>
    </div>

    <p id="message"></p>
  </div>
</main>

<script type="module" src="/js/quiz/quiz.js"></script>
